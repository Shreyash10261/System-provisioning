# Copy this file to terraform.tfvars, then replace EVERY placeholder below.
# terraform.tfvars is ignored by Git so it will not expose your environment values.

aws_region        = "ap-south-1"
availability_zone = "ap-south-1a"
project_name      = "spm-exp2"

# Find this with: curl https://checkip.amazonaws.com
# Add /32, for example: "198.51.100.25/32"
admin_cidr = "REPLACE_WITH_YOUR_PUBLIC_IP/32"

# Create this key pair first in the AWS console in the selected region.
key_pair_name = "REPLACE_WITH_YOUR_EC2_KEY_PAIR_NAME"

# Select a current Amazon Linux AMI in the selected region.
ami_id = "ami-REPLACE_WITH_AMI_ID"

# Keep 2 for the initial deployment. Change to 3 for Output 2.2.
web_count = 2

# t3.micro is the current default because t2.micro is not Free Tier eligible
# for this AWS account. Keep this value unless AWS reports a different eligible type.
instance_type = "t3.micro"
